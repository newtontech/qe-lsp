! Aluminum relaxation
&CONTROL
  calculation = 'relax'
  restart_mode = 'from_scratch'
  pseudo_dir = './pseudo/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 1
  A = 4.05
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  smearing = 'mp'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.7
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
Al 26.982 Al.pbe-nl-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS {angstrom}
Al 0.0 0.0 0.0
K_POINTS {automatic}
12 12 12 0 0 0
