! Spin-polarized iron calculation
&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  pseudo_dir = './pseudo/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 1
  A = 2.87
  nat = 1
  ntyp = 1
  ecutwfc = 50.0
  ecutrho = 400.0
  nspin = 2
  starting_magnetization(1) = 0.6
  occupations = 'smearing'
  smearing = 'mp'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.7
/
ATOMIC_SPECIES
Fe 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS {angstrom}
Fe 0.0 0.0 0.0
K_POINTS {automatic}
8 8 8 0 0 0
