! SiO2 variable-cell relaxation
&CONTROL
  calculation = 'vc-relax'
  restart_mode = 'from_scratch'
  pseudo_dir = './pseudo/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 0
  nat = 9
  ntyp = 2
  ecutwfc = 60.0
  ecutrho = 480.0
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
  cell_dofree = 'all'
/
CELL_PARAMETERS {angstrom}
4.913 0.0 0.0
0.0 4.913 0.0
0.0 0.0 5.405
ATOMIC_SPECIES
Si 28.086 Si.pbe-n-rrkjus_psl.1.0.0.UPF
O 15.999 O.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS {crystal}
Si 0.0 0.0 0.0
Si 0.5 0.5 0.0
Si 0.0 0.0 0.5
O 0.3 0.3 0.25
O 0.7 0.7 0.25
O 0.2 0.2 0.75
O 0.8 0.8 0.75
O 0.0 0.5 0.125
O 0.5 0.0 0.375
K_POINTS {automatic}
4 4 4 0 0 0
